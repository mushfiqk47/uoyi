{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.clipweave.studio",
  "productName": "ClipWeave",
  "directories": {
    "output": "release",
    "buildResources": "public/img"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server/**/*",
    "scripts/**/*",
    "models/yunet.onnx",
    "models.json",
    "package.json"
  ],
  "asarUnpack": [
    "server/**/*",
    "scripts/**/*",
    "models/**/*"
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "artifactName": "ClipWeave-${version}-${os}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "category": "AudioVideo",
    "artifactName": "ClipWeave-${version}-${os}-${arch}.${ext}"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ],
    "category": "public.app-category.video",
    "artifactName": "ClipWeave-${version}-${os}-${arch}.${ext}"
  }
}
