{
  "name": "clipweave-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "nemo:gpu": "nemo-speech serve --asr-model parakeet-tdt --device cuda --port 8081 --cors-origin http://127.0.0.1:8080",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "node server/dev-api.cjs",
    "server": "node server/dev-api.cjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "node --test \"server/*.test.cjs\" \"server/**/*.test.cjs\"",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "share": "npx --yes cloudflared tunnel --url http://127.0.0.1:3000"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
